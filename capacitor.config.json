{
  "appId": "com.cognitiverpg.game",
  "appName": "Mysterium",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#05070b"
  },
  "ios": {
    "backgroundColor": "#05070b",
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#05070b",
      "showSpinner": false
    }
  }
}
